---
layout: base.njk
section: blog
title: Blog
description: Career, academic writing and personal reflections by Tejas H Badala.
---
{% from "ui.njk" import label, icon %}
<div class="wrap inside"><div class="page-heading">{{label('Blog')}}<h1>Essays and reflections</h1><p class="deck">My notebook on law, literature and the questions I carry from the classroom into my working life.</p></div>
{% include "writing-nav.njk" %}
<div class="posts">{% for post in collections.article | reverse %}<article class="post-teaser">{% if post.data.hero %}<a class="teaser-art" href="@root{{post.url}}" aria-label="{{post.data.gloss or post.data.title}}"><img src="@root/assets/{{post.data.hero}}" alt="" loading="lazy"></a>{% endif %}<div class="teaser-copy"><span class="kicker">{{post.data.category}}{% if post.data.language=='kn' %} · Kannada{% endif %}</span><h2><a href="@root{{post.url}}" lang="{{post.data.language or 'en'}}">{{post.data.title}}</a></h2>{% if post.data.gloss %}<p>{{post.data.gloss}}</p>{% endif %}<a class="text-link" href="@root{{post.url}}">Read article</a></div></article>{% endfor %}</div>
</div>
